<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WhiteNoiseApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhiteNoise">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AudioPlayerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- BroadcastReceiver for Tasker, MacroDroid, Automate, and System Shortcuts -->
        <receiver
            android:name=".receiver.TaskerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.agustin.whitenoise.ACTION_PLAY" />
                <action android:name="com.agustin.whitenoise.ACTION_PAUSE" />
                <action android:name="com.agustin.whitenoise.ACTION_STOP" />
                <action android:name="com.agustin.whitenoise.ACTION_TOGGLE" />
                <action android:name="com.agustin.whitenoise.ACTION_PLAY_PRESET" />
                <action android:name="com.agustin.whitenoise.ACTION_SET_TRACK" />
                <action android:name="com.agustin.whitenoise.ACTION_SET_TIMER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
